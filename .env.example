# Set these in Vercel > Project > Settings > Environment Variables (never commit real values).
GITHUB_REPO=your-github-name/trading-dashboard   # this repo; the snapshot lives on its `data` branch
GITHUB_TOKEN=                                     # fine-grained token: this repo only, Contents = Read-only
DASHBOARD_PASSWORD=                               # what you type on the login page
SESSION_SECRET=                                   # any long random text (signs the login cookie)
# Local testing only: read the snapshot from disk instead of GitHub
# SNAPSHOT_FILE=../reports/dashboard_snapshot/snapshot.json
